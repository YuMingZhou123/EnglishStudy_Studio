# ASP.NET Core API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5180

# PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=55432;Database=english_study;Username=english_study;Password=english_study_password

# MinIO / S3 compatible storage
Storage__Endpoint=localhost:9000
Storage__Bucket=english-study
Storage__AccessKey=englishstudy
Storage__SecretKey=englishstudysecret
Storage__UseSSL=false
Storage__PublicApiBaseUrl=http://localhost:5180

# JWT placeholders
Jwt__Issuer=EnglishStudyStudio
Jwt__Audience=EnglishStudyStudio
Jwt__SigningKey=change-this-local-development-key
Jwt__ExpireMinutes=1440

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:5180
